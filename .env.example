# 复制成 .env 后填写。这个文件不要提交到 git。

# ---------- 模型 ----------
# 支持 deepseek / openai / anthropic，或任何 OpenAI 兼容接口
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 推送 ----------
# 飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK=
# 如果创建机器人时勾了「签名校验」，把密钥填这里；没勾就留空
FEISHU_WEBHOOK_SECRET=

# ---------- 阅读形态 ----------
# single = 一张大卡片（末尾有「逐条学习页」按钮）；split = 每条一张小卡片
DIGEST_MODE=single
# 逐条学习页的网址（托管到 GitHub Pages 后填，留空则不出按钮）
# 形如 https://你的名字.github.io/ai-daily/2026-10-28.html
READER_URL=
